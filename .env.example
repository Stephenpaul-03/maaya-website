# Enable Google Books API for this key. Used only by the Node cover script.
# Never prefix this key with NEXT_PUBLIC_; those variables are exposed to the browser.
GOOGLE_BOOKS_API_KEY=

# Public production origin for canonical URLs and sitemap (no trailing path).
# Set the real domain before building for deployment.
SITE_URL=

# Sibling repository containing content/*.json and book-covers/.
CONTENT_REPO_DIR=../content

# Separate content repository. No credentials in this URL.
# HTTPS uses your local Git credential helper; SSH uses your SSH agent.
CONTENT_REPO_URL=https://github.com/Stephenpaul-03/maaya-content.git
CONTENT_REPO_BRANCH=main
# Enable on the website host; leave off for normal local editing.
CONTENT_FETCH_ON_BUILD=0
