{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Margin inquiry content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "ui",
    "businessNumber",
    "email"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greeting",
        "introduction",
        "bookLine",
        "closing"
      ],
      "properties": {
        "greeting": {
          "type": "string",
          "minLength": 1
        },
        "introduction": {
          "type": "string",
          "minLength": 1
        },
        "bookLine": {
          "type": "string",
          "minLength": 1
        },
        "closing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "button",
        "hint",
        "empty",
        "unconfigured",
        "descriptionOne",
        "emailButton"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "button": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "empty": {
          "type": "string",
          "minLength": 1
        },
        "unconfigured": {
          "type": "string",
          "minLength": 1
        },
        "descriptionOne": {
          "type": "string",
          "minLength": 1
        },
        "emailButton": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "businessNumber": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{6,14})?$",
      "description": "International WhatsApp number with country code, digits only. Empty disables inquiries."
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "subject"
      ],
      "properties": {
        "recipient": {
          "type": "string",
          "pattern": "^(?:[^\\s@<>,;:]+@[^\\s@<>,;:]+\\.[^\\s@<>,;:]+)?$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
