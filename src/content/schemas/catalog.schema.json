{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Margin catalog content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "genres",
    "books",
    "languages"
  ],
  "properties": {
    "genres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "author",
          "genreId",
          "cover",
          "note",
          "description",
          "year",
          "languageIds"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "genreId": {
            "type": "string",
            "minLength": 1
          },
          "cover": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "style",
              "footer"
            ],
            "properties": {
              "style": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "creative",
                  "coffee",
                  "disquiet",
                  "sweetgrass",
                  "architecture",
                  "small"
                ]
              },
              "footer": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]{1,4}$"
          },
          "languageIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "nativeLabel",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "nativeLabel": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "ltr",
              "rtl"
            ]
          }
        }
      }
    }
  }
}
