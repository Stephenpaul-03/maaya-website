{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Margin reading-lists content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lists"
  ],
  "properties": {
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title",
          "label",
          "description",
          "ids",
          "color",
          "icon"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "sage",
              "butter",
              "clay"
            ]
          },
          "icon": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  }
}
